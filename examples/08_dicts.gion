name = "answer"
data = {"a": 1, "b": 2, "name": name}
data["c"] = 3
alias = "name"
data[alias] = "updated"
nested = {"inner": data, "empty": {}}

second = data["b"]
named = data["name"]
same = data == {"b": 2, "name": "updated", "a": 1, "c": 3}
size = len(data)

print(data)
print(nested)
print(second)
print(named)
print(same)
print(size)
