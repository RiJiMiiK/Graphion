# 02_arithmetic.gion
# This file demonstrates arithmetic operators, precedence, grouping,
# negative operands, and numeric builtins such as abs() and min().

sum = 40 + 2
mixed = 1 + 2 * 3
grouped = (1 + 2) * 3
delta = 42 - 5
half = 7 / 2
scaled = half * 2

negative_add = -5 + 2
negative_sub = 5 - -2
negative_mul = -3 * 4
negative_div = -7 / 2
count = 5
neg_count = -count
neg_group = -(1 + 2)
neg_abs = -abs(-3)

floor_half = 7 // 2
negative_floor = -7 // 2
float_floor = 7.5 // 2

power = 2 ** 3
negative_power = (-2) ** 3
negative_exponent = 2 ** -1
right_assoc = 2 ** 3 ** 2
powered_group = (1 + 2) ** 2

remainder = 10 % 4
negative_remainder = -10 % 4
float_remainder = 7.5 % 2

abs_count = abs(-42)
abs_ratio = abs(-3.5)
abs_expression = abs(-5 + 2)
min_count = min(7, 3)
min_ratio = min(3.5, 2)
min_expression = min(10 - 2, 3 * 3)

print("basic addition -> sum=" + sum)
print("operator precedence -> mixed=" + mixed)
print("parentheses override precedence -> grouped=" + grouped)
print("subtraction -> delta=" + delta)
print("division -> half=" + half)
print("multiplication -> scaled=" + scaled)
print("addition with negative numbers -> negative_add=" + negative_add)
print("subtraction with negative numbers -> negative_sub=" + negative_sub)
print("multiplication with negative numbers -> negative_mul=" + negative_mul)
print("division with negative numbers -> negative_div=" + negative_div)
print("unary minus on a variable -> neg_count=" + neg_count)
print("unary minus on a grouped expression -> neg_group=" + neg_group)
print("unary minus on abs(...) -> neg_abs=" + neg_abs)
print("floor division -> floor_half=" + floor_half)
print("floor division with negative numbers -> negative_floor=" + negative_floor)
print("floor division with floats -> float_floor=" + float_floor)
print("power -> power=" + power)
print("power with a negative base -> negative_power=" + negative_power)
print("power with a negative exponent -> negative_exponent=" + negative_exponent)
print("power is right-associative -> right_assoc=" + right_assoc)
print("power with parentheses -> powered_group=" + powered_group)
print("integer modulo -> remainder=" + remainder)
print("modulo with negative numbers -> negative_remainder=" + negative_remainder)
print("float modulo -> float_remainder=" + float_remainder)
print("absolute value of an integer -> abs_count=" + abs_count)
print("absolute value of a float -> abs_ratio=" + abs_ratio)
print("absolute value of an expression -> abs_expression=" + abs_expression)
print("minimum of two integers -> min_count=" + min_count)
print("minimum of mixed numeric values -> min_ratio=" + min_ratio)
print("minimum of two expressions -> min_expression=" + min_expression)
print("raw expression with normal precedence -> " + (3 + 4 * 2))
print("raw expression with grouped precedence -> " + ((3 + 4) * 2))
print("raw modulo expression -> " + (10 % 4))
