csc_right_angle = csc(pi / 2)
csc_negative_right_angle = csc(-pi / 2)
csc_pi_sixth = csc(0.5235987755982988)
sec_zero = sec(0)
sec_pi = sec(pi)
sec_pi_third = sec(1.0471975511965976)
cot_pi_fourth = cot(0.7853981633974483)
cot_negative_pi_fourth = cot(-0.7853981633974483)
cot_pi_sixth = cot(0.5235987755982988)
acsc_one = acsc(1)
acsc_two = acsc(2)
