# 02_arithmetic.gion
# This file demonstrates arithmetic operators, precedence, grouping,
# negative operands, postfix factorial, numeric builtins such as abs(), min(), max(),
# clamp(), sqrt(), cbrt(), sin(), sinh(), asinh(), acosh(), cos(), cosh(), tan(), tanh(), atanh(), asin(), acos(), atan(), atan2(), hypot(), degrees(), radians(), isnan(), isinf(), isfinite(), exp(), ln(), log(), log10(), log2(), floor(), ceil(), round(), trunc(), sign(), and the string builtin len().

sum = 40 + 2
mixed = 1 + 2 * 3
grouped = (1 + 2) * 3
delta = 42 - 5
half = 7 / 2
scaled = half * 2

negative_add = -5 + 2
negative_sub = 5 - -2
negative_mul = -3 * 4
negative_div = -7 / 2
count = 5
neg_count = -count
neg_group = -(1 + 2)
neg_abs = -abs(-3)

floor_half = 7 // 2
negative_floor = -7 // 2
float_floor = 7.5 // 2

power = 2 ** 3
negative_power = (-2) ** 3
negative_exponent = 2 ** -1
right_assoc = 2 ** 3 ** 2
powered_group = (1 + 2) ** 2
factorial_zero = 0!
factorial_count = 5!
factorial_group = (1 + 2)!

remainder = 10 % 4
negative_remainder = -10 % 4
float_remainder = 7.5 % 2

abs_count = abs(-42)
abs_ratio = abs(-3.5)
abs_expression = abs(-5 + 2)
min_count = min(7, 3)
min_ratio = min(3.5, 2)
min_expression = min(10 - 2, 3 * 3)
max_count = max(7, 3)
max_ratio = max(3.5, 2)
max_expression = max(10 - 2, 3 * 3)
clamp_low = clamp(-2, 0, 10)
clamp_mid = clamp(5, 0, 10)
clamp_high = clamp(17, 0, 10)
clamp_float = clamp(12.5, 0, 10)
sqrt_count = sqrt(9)
sqrt_ratio = sqrt(2.25)
sqrt_expression = sqrt(1 + 8)
cbrt_count = cbrt(27)
cbrt_negative = cbrt(-8)
cbrt_expression = cbrt(1 + 26)
sin_zero = sin(0)
sin_half_turn = sin(pi / 2)
sin_expression = sin(1.5707963267948966)
sinh_zero = sinh(0)
sinh_one = sinh(1)
sinh_negative = sinh(-1)
asinh_zero = asinh(0)
asinh_one = asinh(1)
asinh_negative = asinh(-1)
acosh_one = acosh(1)
acosh_two = acosh(2)
acosh_four = acosh(4)
cosh_zero = cosh(0)
cosh_one = cosh(1)
cosh_negative = cosh(-1)
tanh_zero = tanh(0)
tanh_one = tanh(1)
tanh_negative = tanh(-1)
atanh_zero = atanh(0)
atanh_half = atanh(0.5)
atanh_negative_half = atanh(-0.5)
cos_zero = cos(0)
cos_pi = cos(pi)
cos_expression = cos(3.14159265358979323846)
tan_zero = tan(0)
tan_quarter_turn = tan(pi / 4)
tan_expression = tan(0.7853981633974483)
asin_zero = asin(0)
asin_one = asin(1)
asin_half = asin(0.5)
acos_one = acos(1)
acos_zero = acos(0)
acos_half = acos(0.5)
atan_zero = atan(0)
atan_one = atan(1)
atan_negative_one = atan(-1)
atan2_diag = atan2(1, 1)
atan2_quadrant_two = atan2(1, -1)
atan2_quadrant_three = atan2(-1, -1)
hypot_diag = hypot(3, 4)
hypot_large = hypot(5, 12)
hypot_negative = hypot(-3, 4)
degrees_zero = degrees(0)
degrees_right_angle = degrees(pi / 2)
degrees_negative_quarter = degrees(-0.7853981633974483)
radians_zero = radians(0)
radians_straight = radians(180)
radians_negative_quarter = radians(-45)
isnan_nan = isnan(nan)
isnan_one = isnan(1.0)
isnan_count = isnan(7)
isinf_inf = isinf(inf)
isinf_one = isinf(1.0)
isinf_count = isinf(7)
isfinite_inf = isfinite(inf)
isfinite_nan = isfinite(nan)
isfinite_one = isfinite(1.0)
isfinite_count = isfinite(7)
exp_count = exp(1)
exp_zero = exp(0.0)
exp_expression = exp(1 + 1)
ln_one = ln(1)
ln_e = ln(e)
ln_expression = ln(e ** 2)
log_count = log(8, 2)
log_decimal = log(100, 10)
log_expression = log(2 ** 5, 2)
log10_count = log10(1000)
log10_decimal = log10(10.0)
log10_expression = log10(10 ** 4)
log2_count = log2(8)
log2_decimal = log2(2.0)
log2_expression = log2(2 ** 6)
floor_count = floor(7)
floor_ratio = floor(7.5)
floor_negative = floor(-3.2)
ceil_count = ceil(7)
ceil_ratio = ceil(7.5)
ceil_negative = ceil(-3.2)
round_count = round(7)
round_ratio = round(7.4)
round_half = round(7.5)
round_negative = round(-3.2)
round_negative_half = round(-3.5)
trunc_count = trunc(7)
trunc_ratio = trunc(7.9)
trunc_negative = trunc(-3.9)
trunc_small_negative = trunc(-0.4)
sign_positive = sign(7)
sign_negative = sign(-3.9)
sign_zero = sign(0)
pi_value = pi
e_value = e
nan_value = nan
inf_value = inf
len_text = len("graphion")
len_concat = len("graph" + "ion")

print("basic addition -> sum=" + sum)
print("operator precedence -> mixed=" + mixed)
print("parentheses override precedence -> grouped=" + grouped)
print("subtraction -> delta=" + delta)
print("division -> half=" + half)
print("multiplication -> scaled=" + scaled)
print("addition with negative numbers -> negative_add=" + negative_add)
print("subtraction with negative numbers -> negative_sub=" + negative_sub)
print("multiplication with negative numbers -> negative_mul=" + negative_mul)
print("division with negative numbers -> negative_div=" + negative_div)
print("unary minus on a variable -> neg_count=" + neg_count)
print("unary minus on a grouped expression -> neg_group=" + neg_group)
print("unary minus on abs(...) -> neg_abs=" + neg_abs)
print("floor division -> floor_half=" + floor_half)
print("floor division with negative numbers -> negative_floor=" + negative_floor)
print("floor division with floats -> float_floor=" + float_floor)
print("power -> power=" + power)
print("power with a negative base -> negative_power=" + negative_power)
print("power with a negative exponent -> negative_exponent=" + negative_exponent)
print("power is right-associative -> right_assoc=" + right_assoc)
print("power with parentheses -> powered_group=" + powered_group)
print("factorial of zero -> factorial_zero=" + factorial_zero)
print("factorial of an integer -> factorial_count=" + factorial_count)
print("factorial of a grouped expression -> factorial_group=" + factorial_group)
print("integer modulo -> remainder=" + remainder)
print("modulo with negative numbers -> negative_remainder=" + negative_remainder)
print("float modulo -> float_remainder=" + float_remainder)
print("absolute value of an integer -> abs_count=" + abs_count)
print("absolute value of a float -> abs_ratio=" + abs_ratio)
print("absolute value of an expression -> abs_expression=" + abs_expression)
print("minimum of two integers -> min_count=" + min_count)
print("minimum of mixed numeric values -> min_ratio=" + min_ratio)
print("minimum of two expressions -> min_expression=" + min_expression)
print("maximum of two integers -> max_count=" + max_count)
print("maximum of mixed numeric values -> max_ratio=" + max_ratio)
print("maximum of two expressions -> max_expression=" + max_expression)
print("clamp below lower bound -> clamp_low=" + clamp_low)
print("clamp inside range -> clamp_mid=" + clamp_mid)
print("clamp above upper bound -> clamp_high=" + clamp_high)
print("clamp float above upper bound -> clamp_float=" + clamp_float)
print("square root of an integer -> sqrt_count=" + sqrt_count)
print("square root of a float -> sqrt_ratio=" + sqrt_ratio)
print("square root of an expression -> sqrt_expression=" + sqrt_expression)
print("cube root of an integer -> cbrt_count=" + cbrt_count)
print("cube root of a negative number -> cbrt_negative=" + cbrt_negative)
print("cube root of an expression -> cbrt_expression=" + cbrt_expression)
print("sin at zero radians -> sin_zero=" + sin_zero)
print("sin at pi/2 radians -> sin_half_turn=" + sin_half_turn)
print("sin of a radians literal -> sin_expression=" + sin_expression)
print("sinh at zero radians -> sinh_zero=" + sinh_zero)
print("sinh at one radian -> sinh_one=" + sinh_one)
print("sinh at minus one radian -> sinh_negative=" + sinh_negative)
print("asinh at zero -> asinh_zero=" + asinh_zero)
print("asinh at one -> asinh_one=" + asinh_one)
print("asinh at minus one -> asinh_negative=" + asinh_negative)
print("acosh at one -> acosh_one=" + acosh_one)
print("acosh at two -> acosh_two=" + acosh_two)
print("acosh at four -> acosh_four=" + acosh_four)
print("cosh at zero radians -> cosh_zero=" + cosh_zero)
print("cosh at one radian -> cosh_one=" + cosh_one)
print("cosh at minus one radian -> cosh_negative=" + cosh_negative)
print("tanh at zero radians -> tanh_zero=" + tanh_zero)
print("tanh at one radian -> tanh_one=" + tanh_one)
print("tanh at minus one radian -> tanh_negative=" + tanh_negative)
print("atanh at zero -> atanh_zero=" + atanh_zero)
print("atanh at one-half -> atanh_half=" + atanh_half)
print("atanh at minus one-half -> atanh_negative_half=" + atanh_negative_half)
print("cos at zero radians -> cos_zero=" + cos_zero)
print("cos at pi radians -> cos_pi=" + cos_pi)
print("cos of a radians literal -> cos_expression=" + cos_expression)
print("tan at zero radians -> tan_zero=" + tan_zero)
print("tan at pi/4 radians -> tan_quarter_turn=" + tan_quarter_turn)
print("tan of a radians literal -> tan_expression=" + tan_expression)
print("asin at zero -> asin_zero=" + asin_zero)
print("asin at one -> asin_one=" + asin_one)
print("asin at one-half -> asin_half=" + asin_half)
print("acos at one -> acos_one=" + acos_one)
print("acos at zero -> acos_zero=" + acos_zero)
print("acos at one-half -> acos_half=" + acos_half)
print("atan at zero -> atan_zero=" + atan_zero)
print("atan at one -> atan_one=" + atan_one)
print("atan at negative one -> atan_negative_one=" + atan_negative_one)
print("atan2 on the unit diagonal -> atan2_diag=" + atan2_diag)
print("atan2 in quadrant two -> atan2_quadrant_two=" + atan2_quadrant_two)
print("atan2 in quadrant three -> atan2_quadrant_three=" + atan2_quadrant_three)
print("hypot on a 3-4-5 triangle -> hypot_diag=" + hypot_diag)
print("hypot on a 5-12-13 triangle -> hypot_large=" + hypot_large)
print("hypot ignores sign on coordinates -> hypot_negative=" + hypot_negative)
print("degrees at zero radians -> degrees_zero=" + degrees_zero)
print("degrees at pi/2 radians -> degrees_right_angle=" + degrees_right_angle)
print("degrees at negative pi/4 radians -> degrees_negative_quarter=" + degrees_negative_quarter)
print("radians at zero degrees -> radians_zero=" + radians_zero)
print("radians at 180 degrees -> radians_straight=" + radians_straight)
print("radians at negative 45 degrees -> radians_negative_quarter=" + radians_negative_quarter)
print("isnan on nan -> isnan_nan=" + isnan_nan)
print("isnan on a float -> isnan_one=" + isnan_one)
print("isnan on an int -> isnan_count=" + isnan_count)
print("isinf on inf -> isinf_inf=" + isinf_inf)
print("isinf on a float -> isinf_one=" + isinf_one)
print("isinf on an int -> isinf_count=" + isinf_count)
print("isfinite on inf -> isfinite_inf=" + isfinite_inf)
print("isfinite on nan -> isfinite_nan=" + isfinite_nan)
print("isfinite on a float -> isfinite_one=" + isfinite_one)
print("isfinite on an int -> isfinite_count=" + isfinite_count)
print("exp of an integer -> exp_count=" + exp_count)
print("exp of zero -> exp_zero=" + exp_zero)
print("exp of an expression -> exp_expression=" + exp_expression)
print("ln of one -> ln_one=" + ln_one)
print("ln of e -> ln_e=" + ln_e)
print("ln of an expression -> ln_expression=" + ln_expression)
print("log base two of eight -> log_count=" + log_count)
print("log base ten of one hundred -> log_decimal=" + log_decimal)
print("log of an expression -> log_expression=" + log_expression)
print("log10 of one thousand -> log10_count=" + log10_count)
print("log10 of ten -> log10_decimal=" + log10_decimal)
print("log10 of an expression -> log10_expression=" + log10_expression)
print("log2 of eight -> log2_count=" + log2_count)
print("log2 of two -> log2_decimal=" + log2_decimal)
print("log2 of an expression -> log2_expression=" + log2_expression)
print("floor of an integer -> floor_count=" + floor_count)
print("floor of a float -> floor_ratio=" + floor_ratio)
print("floor of a negative float -> floor_negative=" + floor_negative)
print("ceil of an integer -> ceil_count=" + ceil_count)
print("ceil of a float -> ceil_ratio=" + ceil_ratio)
print("ceil of a negative float -> ceil_negative=" + ceil_negative)
print("round of an integer -> round_count=" + round_count)
print("round of a float -> round_ratio=" + round_ratio)
print("round of a halfway float -> round_half=" + round_half)
print("round of a negative float -> round_negative=" + round_negative)
print("round of a negative halfway float -> round_negative_half=" + round_negative_half)
print("trunc of an integer -> trunc_count=" + trunc_count)
print("trunc of a float -> trunc_ratio=" + trunc_ratio)
print("trunc of a negative float -> trunc_negative=" + trunc_negative)
print("trunc of a small negative float -> trunc_small_negative=" + trunc_small_negative)
print("sign of a positive number -> sign_positive=" + sign_positive)
print("sign of a negative number -> sign_negative=" + sign_negative)
print("sign of zero -> sign_zero=" + sign_zero)
print("pi constant -> pi_value=" + pi_value)
print("e constant -> e_value=" + e_value)
print("length of a string literal -> len_text=" + len_text)
print("length of a string expression -> len_concat=" + len_concat)
print("raw expression with normal precedence -> " + (3 + 4 * 2))
print("raw expression with grouped precedence -> " + ((3 + 4) * 2))
print("raw modulo expression -> " + (10 % 4))
