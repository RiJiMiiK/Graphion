# 02_arithmetic.gion
# This file demonstrates arithmetic operators, precedence, grouping,
# negative operands, postfix factorial, numeric builtins such as abs(), min(), max(),
# clamp(), sqrt(), cbrt(), sin(), csc(), sec(), cot(), acsc(), asec(), acot(), sech(), csch(), coth(), sinh(), asinh(), acosh(), cos(), cosh(), tan(), tanh(), atanh(), asin(), acos(), atan(), atan2(), hypot(), copysign(), fma(), fdim(), remainder(), rint(), degrees(), radians(), isnan(), isinf(), isfinite(), exp(), exp2(), expm1(), log1p(), erf(), erfc(), gamma(), lgamma(), ln(), log(), log10(), log2(), floor(), ceil(), round(), trunc(), fract(), sign(), and the string builtin len().

sum = 40 + 2
mixed = 1 + 2 * 3
grouped = (1 + 2) * 3
delta = 42 - 5
half = 7 / 2
scaled = half * 2

negative_add = -5 + 2
negative_sub = 5 - -2
negative_mul = -3 * 4
negative_div = -7 / 2
count = 5
neg_count = -count
neg_group = -(1 + 2)
neg_abs = -abs(-3)

floor_half = 7 // 2
negative_floor = -7 // 2
float_floor = 7.5 // 2

power = 2 ** 3
negative_power = (-2) ** 3
negative_exponent = 2 ** -1
right_assoc = 2 ** 3 ** 2
powered_group = (1 + 2) ** 2
factorial_zero = 0!
factorial_count = 5!
factorial_group = (1 + 2)!

modulo_value = 10 % 4
modulo_negative = -10 % 4
modulo_float = 7.5 % 2

abs_count = abs(-42)
abs_ratio = abs(-3.5)
abs_expression = abs(-5 + 2)
min_count = min(7, 3)
min_ratio = min(3.5, 2)
min_expression = min(10 - 2, 3 * 3)
max_count = max(7, 3)
max_ratio = max(3.5, 2)
max_expression = max(10 - 2, 3 * 3)
clamp_low = clamp(-2, 0, 10)
clamp_mid = clamp(5, 0, 10)
clamp_high = clamp(17, 0, 10)
clamp_float = clamp(12.5, 0, 10)
sqrt_count = sqrt(9)
sqrt_ratio = sqrt(2.25)
sqrt_expression = sqrt(1 + 8)
cbrt_count = cbrt(27)
cbrt_negative = cbrt(-8)
cbrt_expression = cbrt(1 + 26)
sin_zero = sin(0)
sin_half_turn = sin(pi / 2)
