# 06_bits_literals.gion
# This file demonstrates the current `bits` V1 literal subset.
# Width is preserved from the literal spelling.

short_bits = 0b10
wide_bits = 0b0010
copied_bits = wide_bits
same_bits = 0b10 == 0b0010
different_bits = 0b10 != 0b0011
masked_bits = 0b1100 & 0b1010
merged_bits = 0b1100 | 0b1010
xor_bits = 0b1100 ^ 0b1010
not_wide_bits = ~0b0010
not_short_bits = ~0b10
shifted_bits = 0b0011 << 1
truncated_shift_bits = 0b1111 << 1
right_shifted_bits = 0b1010 >> 1
cleared_right_shift_bits = 0b1010 >> 4
grouped_mask_then_shift_bits = (0b1100 & 0b1010) >> 1
not_then_mask_bits = ~0b0011 & 0b1111
shift_count_expression_bits = 0b0011 << (1 + 1)

print("bits literal with width 2 -> short_bits=" + short_bits)
print("bits literal with width 4 -> wide_bits=" + wide_bits)
print("copied bits preserve width -> copied_bits=" + copied_bits)
print("bits equality ignores leading zeroes -> same_bits=" + same_bits)
print("bits inequality compares normalized values -> different_bits=" + different_bits)
print("bits and keeps matching width -> masked_bits=" + masked_bits)
print("bits or keeps matching width -> merged_bits=" + merged_bits)
print("bits xor keeps matching width -> xor_bits=" + xor_bits)
print("bits not keeps width 4 -> not_wide_bits=" + not_wide_bits)
print("bits not keeps width 2 -> not_short_bits=" + not_short_bits)
print("bits left shift keeps width -> shifted_bits=" + shifted_bits)
print("bits left shift truncates overflow -> truncated_shift_bits=" + truncated_shift_bits)
print("bits right shift keeps width -> right_shifted_bits=" + right_shifted_bits)
print("bits right shift fills with zeroes -> cleared_right_shift_bits=" + cleared_right_shift_bits)
print("grouped bits and then right shift -> grouped_mask_then_shift_bits=" + grouped_mask_then_shift_bits)
print("bits not binds before bits and -> not_then_mask_bits=" + not_then_mask_bits)
print("bits shift count can be an int expression -> shift_count_expression_bits=" + shift_count_expression_bits)
