# sample_test.gion is the quick overview script.
# For more focused examples, also see:
# - 01_scalars_and_print.gion
# - 02_arithmetic.gion
# - 03_compound_assignments.gion
# - 04_conditionals.gion
# - 05_comments.gion
# - 06_bits_literals.gion

count = 42
ratio = 7 / 2
smallest = min(7, 3)
smallest_mixed = min(3.5, 2)
largest = max(7, 3)
largest_mixed = max(3.5, 2)
clamped_low = clamp(-2, 0, 10)
clamped_mid = clamp(5, 0, 10)
clamped_high = clamp(17, 0, 10)
sqrt_overview = sqrt(9)
sqrt_overview_float = sqrt(2.25)
exp_overview = exp(1)
exp_overview_zero = exp(0.0)
ln_overview = ln(1)
ln_overview_e = ln(e)
pi_overview = pi
e_overview = e
factorial_overview = 5!
message = "graph" + "ion"
message_len = len(message)
ready = true
short_bits = 0b10
wide_bits = 0b0010
same_bits = 0b10 == 0b0010
different_bits = 0b10 != 0b0011
masked_bits = 0b1100 & 0b1010
merged_bits = 0b1100 | 0b1010
xor_bits = 0b1100 ^ 0b1010
not_wide_bits = ~0b0010
not_short_bits = ~0b10
shifted_bits = 0b0011 << 1
truncated_shift_bits = 0b1111 << 1
right_shifted_bits = 0b1010 >> 1
cleared_right_shift_bits = 0b1010 >> 4
grouped_mask_then_shift_bits = (0b1100 & 0b1010) >> 1
not_then_mask_bits = ~0b0011 & 0b1111
shift_count_expression_bits = 0b0011 << (1 + 1)
compound_mask_bits = 0b1100
compound_mask_bits &= 0b1010
compound_merge_bits = 0b1100
compound_merge_bits |= 0b0011
compound_flip_bits = 0b1100
compound_flip_bits ^= 0b1010
compound_shift_bits = 0b0011
compound_shift_bits <<= 1
compound_shift_overflow_bits = 0b1111
compound_shift_overflow_bits <<= 1
compound_right_shift_bits = 0b1010
compound_right_shift_bits >>= 1
compound_right_shift_clear_bits = 0b1010
compound_right_shift_clear_bits >>= 4
same_number = 42 == 42
same_text = "graphion" == "graphion"
int_bool_true = 1 == true
int_bool_false = 0 == false
different_number = 42 != 41
different_text = "graphion" != "graph"
smaller_number = 2 < 3
same_or_smaller = 3 <= 3
greater_number = 4 > 3
same_or_greater = 4 >= 4
both_ready = true and 1
all_ready = true and 1 and 2 < 3
not_both_ready = true nand 1
any_ready = false or 1
none_ready = false nor 0
any_path = false or 1 == 1 or false
inverted_ready = not false
inverted_path = not (false or 0)
safe_short_and = false and 2
safe_short_or = true or 2
safe_short_nand = false nand 2
safe_short_nor = true nor 2
has_token = true
level = 3
blocked = false

count += 1
message += "!"

if ready:
    branch = "ready branch"
else:
    branch = "fallback branch"

if 1 + 1 == 2:
    equality_branch = "1 + 1 == 2 is true"
else:
    equality_branch = "bad"

if 2 + 2 != 5:
    inequality_branch = "2 + 2 != 5 is true"
else:
    inequality_branch = "bad"

if 2 < 3:
    less_than_branch = "2 < 3 is true"
else:
    less_than_branch = "bad"

if 3 <= 3:
    less_equal_branch = "3 <= 3 is true"
else:
    less_equal_branch = "bad"

if 4 > 3:
    greater_than_branch = "4 > 3 is true"
else:
    greater_than_branch = "bad"

if 4 >= 4:
    greater_equal_branch = "4 >= 4 is true"
else:
    greater_equal_branch = "bad"

if true and 1:
    and_branch = "true and 1 is true"
else:
    and_branch = "bad"
if true nand 1:
    nand_branch = "bad"
else:
    nand_branch = "true nand 1 is false"

if false or 1:
    or_branch = "false or 1 is true"
else:
    or_branch = "bad"
if false nor 0:
    nor_branch = "false nor 0 is true"
else:
    nor_branch = "bad"
if not false:
    not_branch = "not false is true"
else:
    not_branch = "bad"

if (
    ready and
    has_token and
    level >= 3 and
    not blocked
):
    multiline_branch = "grouped multiline condition works"
else:
    multiline_branch = "bad"

ternary_branch = "ready ternary" if ready else "fallback ternary"
ternary_multiline = (
    "ready multiline ternary"
    if ready
    else "fallback multiline ternary"
)
status = "ready"
match_branch = "unset"
match_group = "unset"

match status:
    "waiting":
        match_branch = "waiting branch"
    "ready":
        match_branch = "ready branch"
    default:
        match_branch = "default branch"

match 2:
    1:
    2:
        match_group = "grouped number branch"
    default:
        match_group = "default number branch"

/* block comments are also ignored */

print("overview assignment -> count=" + count)
print("overview arithmetic -> ratio=" + ratio)
print("overview min builtin -> smallest=" + smallest)
print("overview min builtin on mixed numeric values -> smallest_mixed=" + smallest_mixed)
print("overview max builtin -> largest=" + largest)
print("overview max builtin on mixed numeric values -> largest_mixed=" + largest_mixed)
print("overview clamp builtin low -> clamped_low=" + clamped_low)
print("overview clamp builtin mid -> clamped_mid=" + clamped_mid)
print("overview clamp builtin high -> clamped_high=" + clamped_high)
print("overview sqrt builtin -> sqrt_overview=" + sqrt_overview)
print("overview sqrt builtin on float -> sqrt_overview_float=" + sqrt_overview_float)
print("overview exp builtin -> exp_overview=" + exp_overview)
print("overview exp builtin at zero -> exp_overview_zero=" + exp_overview_zero)
print("overview ln builtin -> ln_overview=" + ln_overview)
print("overview ln builtin at e -> ln_overview_e=" + ln_overview_e)
print("overview pi constant -> pi_overview=" + pi_overview)
print("overview e constant -> e_overview=" + e_overview)
print("overview factorial operator -> factorial_overview=" + factorial_overview)
print("overview string concat -> message=" + message)
print("overview len builtin -> message_len=" + message_len)
print("overview bits literal -> short_bits=" + short_bits)
print("overview bits width preservation -> wide_bits=" + wide_bits)
print("overview bits equality -> same_bits=" + same_bits)
print("overview bits inequality -> different_bits=" + different_bits)
print("overview bits and -> masked_bits=" + masked_bits)
print("overview bits or -> merged_bits=" + merged_bits)
print("overview bits xor -> xor_bits=" + xor_bits)
print("overview bits not width 4 -> not_wide_bits=" + not_wide_bits)
print("overview bits not width 2 -> not_short_bits=" + not_short_bits)
print("overview bits left shift -> shifted_bits=" + shifted_bits)
print("overview bits left shift truncation -> truncated_shift_bits=" + truncated_shift_bits)
print("overview bits right shift -> right_shifted_bits=" + right_shifted_bits)
print("overview bits right shift zero-fill -> cleared_right_shift_bits=" + cleared_right_shift_bits)
print("overview bits grouped and then right shift -> grouped_mask_then_shift_bits=" + grouped_mask_then_shift_bits)
print("overview bits not before and -> not_then_mask_bits=" + not_then_mask_bits)
print("overview bits shift count expression -> shift_count_expression_bits=" + shift_count_expression_bits)
print("overview bits &= -> compound_mask_bits=" + compound_mask_bits)
print("overview bits |= -> compound_merge_bits=" + compound_merge_bits)
print("overview bits ^= -> compound_flip_bits=" + compound_flip_bits)
print("overview bits <<= -> compound_shift_bits=" + compound_shift_bits)
print("overview bits <<= truncation -> compound_shift_overflow_bits=" + compound_shift_overflow_bits)
print("overview bits >>= -> compound_right_shift_bits=" + compound_right_shift_bits)
print("overview bits >>= zero-fill -> compound_right_shift_clear_bits=" + compound_right_shift_clear_bits)
print("overview equality on numbers -> same_number=" + same_number)
print("overview equality on strings -> same_text=" + same_text)
print("overview equality on int/bool true -> int_bool_true=" + int_bool_true)
print("overview equality on int/bool false -> int_bool_false=" + int_bool_false)
print("overview inequality on numbers -> different_number=" + different_number)
print("overview inequality on strings -> different_text=" + different_text)
print("overview less-than on numbers -> smaller_number=" + smaller_number)
print("overview less-equal on numbers -> same_or_smaller=" + same_or_smaller)
print("overview greater-than on numbers -> greater_number=" + greater_number)
print("overview greater-equal on numbers -> same_or_greater=" + same_or_greater)
print("overview boolean logic -> both_ready=" + both_ready)
print("overview chained and -> all_ready=" + all_ready)
print("overview boolean nand -> not_both_ready=" + not_both_ready)
print("overview boolean logic -> any_ready=" + any_ready)
print("overview boolean nor -> none_ready=" + none_ready)
print("overview chained or -> any_path=" + any_path)
print("overview boolean not -> inverted_ready=" + inverted_ready)
print("overview grouped not -> inverted_path=" + inverted_path)
print("overview short-circuit and -> safe_short_and=" + safe_short_and)
print("overview short-circuit or -> safe_short_or=" + safe_short_or)
print("overview short-circuit nand -> safe_short_nand=" + safe_short_nand)
print("overview short-circuit nor -> safe_short_nor=" + safe_short_nor)
print("overview multiline grouped condition -> multiline_branch=" + multiline_branch)
print("overview ternary condition -> ternary_branch=" + ternary_branch)
print("overview multiline ternary condition -> ternary_multiline=" + ternary_multiline)
print("overview match on string -> match_branch=" + match_branch)
print("overview match grouped cases -> match_group=" + match_group)
print("overview conditional -> branch=" + branch)
print("overview equality in condition -> equality_branch=" + equality_branch)
print("overview inequality in condition -> inequality_branch=" + inequality_branch)
print("overview less-than in condition -> less_than_branch=" + less_than_branch)
print("overview less-equal in condition -> less_equal_branch=" + less_equal_branch)
print("overview greater-than in condition -> greater_than_branch=" + greater_than_branch)
print("overview greater-equal in condition -> greater_equal_branch=" + greater_equal_branch)
print("overview and in condition -> and_branch=" + and_branch)
print("overview nand in condition -> nand_branch=" + nand_branch)
print("overview or in condition -> or_branch=" + or_branch)
print("overview nor in condition -> nor_branch=" + nor_branch)
print("overview not in condition -> not_branch=" + not_branch)
print("overview print coercion -> " + "Test " + 7)
