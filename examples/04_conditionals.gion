# 04_conditionals.gion
# This file demonstrates if / elif / else forms,
# equality conditions, and the current 0/1 rule.

branch_flag = true
other_branch = false

if branch_flag:
    branch_demo = "if branch"
elif other_branch:
    branch_demo = "elif branch"
else:
    branch_demo = "else branch"

if false:
    optional_branch = "bad"
else:
    optional_branch = "if + else without elif"

if 1:
    integer_bool_branch = "integer 1 acts like true"
else:
    integer_bool_branch = "bad"

if 0:
    integer_zero_branch = "bad"
else:
    integer_zero_branch = "integer 0 acts like false"

if false:
    single_if_demo = "bad"
single_if_demo = "if without else keeps flowing"

if 1 + 1 == 2:
    equality_branch = "1 + 1 == 2 is true"
else:
    equality_branch = "bad"

if 2 + 2 != 5:
    inequality_branch = "2 + 2 != 5 is true"
else:
    inequality_branch = "bad"

if 2 < 3:
    less_than_branch = "2 < 3 is true"
else:
    less_than_branch = "bad"

if 3 <= 3:
    less_equal_branch = "3 <= 3 is true"
else:
    less_equal_branch = "bad"

bool_bridge_true = 1 == true
bool_bridge_false = 0 == false

print("if / elif / else with booleans -> branch_demo=" + branch_demo)
print("if + else without elif -> optional_branch=" + optional_branch)
print("if with integer 1 -> integer_bool_branch=" + integer_bool_branch)
print("if with integer 0 -> integer_zero_branch=" + integer_zero_branch)
print("if without else -> single_if_demo=" + single_if_demo)
print("if with equality expression -> equality_branch=" + equality_branch)
print("if with inequality expression -> inequality_branch=" + inequality_branch)
print("if with less-than expression -> less_than_branch=" + less_than_branch)
print("if with less-equal expression -> less_equal_branch=" + less_equal_branch)
print("int and bool equality -> bool_bridge_true=" + bool_bridge_true)
print("int and bool equality -> bool_bridge_false=" + bool_bridge_false)
